# Local walkthrough default. Use `required` before any shared or deployed environment.
KYNEX_AUTH_MODE=demo
KYNEX_ALLOWED_ORIGIN=http://localhost:5173
KYNEX_MAX_BODY_BYTES=10485760

# Required when KYNEX_AUTH_MODE=required.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Vite exposes only VITE_ variables to the browser client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Never put a Supabase secret key or an LLM API key in the frontend environment.
# Server-only secrets belong in the deployment secret manager.
